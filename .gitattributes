# Stable GitHub diffs and text line endings
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.desktop text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
